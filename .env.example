# The /support-demo workspace needs NO environment variables.
# The following are OPTIONAL for the original upstream chat application only.
# Use dedicated disposable services. Never use production or customer credentials.
# Copy to .env.local only when testing the upstream app; do not commit that file.

# Generate locally with: openssl rand -base64 32
AUTH_SECRET=
# Original chat model requests may incur provider charges.
AI_GATEWAY_API_KEY=
# Optional upstream storage and database services.
BLOB_READ_WRITE_TOKEN=
POSTGRES_URL=
REDIS_URL=
