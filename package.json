{
  "name": "chatbot",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "tsx lib/db/migrate && next build",
    "start": "next start",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "test": "export PLAYWRIGHT=True && pnpm exec playwright test",
    "test:support": "node --import tsx --test tests/support/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo:support": "next dev --hostname 127.0.0.1 --port 3100",
    "test:support:smoke": "node scripts/support-smoke.mjs",
    "test:support:e2e": "playwright test --config playwright.support.config.ts",
    "build:support:static": "node scripts/build-support-static.mjs",
    "test:support:static": "playwright test --config playwright.static.config.ts"
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.15",
